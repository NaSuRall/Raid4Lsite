# Nom du voyage affiche sur le site et utilise comme titre d'album par defaut
TRIP_NAME="Notre Voyage"

# Port d'ecoute du serveur
PORT=3000

# URL publique du site (utilisee dans les emails). Ex: https://album.mondomaine.com
APP_BASE_URL=http://localhost:3000

# Dossier de stockage des donnees (photos, base, fichiers generes). Optionnel.
# DATA_DIR=/var/www/album-voyage/data

# --- Envoi d'emails (optionnel : sans ces variables, l'email est simplement desactive) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_NAME="Album Voyage"
FROM_EMAIL=
